{
  "name": "@speculoai/baton",
  "version": "0.5.0",
  "description": "Hand a bounded coding task to another local agent CLI, then continue the same session when it needs a decision.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpeculoAI/baton.git"
  },
  "bin": {
    "baton": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "tsc --noEmit && node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.20.2"
  },
  "engines": {
    "node": ">=20.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
